# 复制为 .env 并填写（或直接 export 到环境变量里）

# ---- 飞书自建应用（开放平台「凭证与基础信息」里拿）----
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 事件订阅页的 Verification Token（推荐填，用于校验来源）
FEISHU_VERIFICATION_TOKEN=
# 事件订阅页的 Encrypt Key（仅当你开启了「加密推送」时才填）
FEISHU_ENCRYPT_KEY=
# 国内飞书用默认值；国际版 Lark 改为 https://open.larksuite.com
FEISHU_BASE_URL=https://open.feishu.cn

# ---- Claude API（platform.claude.com 申请）----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-opus-4-8

# ---- 可选 ----
SYSTEM_PROMPT=你是一个运行在飞书里的智能助手，由 Claude 提供能力。回答简洁、清晰、友好，默认使用中文。
MAX_HISTORY=20
